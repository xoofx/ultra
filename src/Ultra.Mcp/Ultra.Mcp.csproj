<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- Shipped inside the ultra global tool (`ultra mcp`), not as a package of its own -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.Core" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="LlmGuide.md">
      <LogicalName>LlmGuide.md</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Ultra.Core" />
    <InternalsVisibleTo Include="ultra" />
    <InternalsVisibleTo Include="Ultra.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ultra.Core\Ultra.Core.csproj" />
  </ItemGroup>
</Project>
